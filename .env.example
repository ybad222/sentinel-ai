ENV=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- LLM: ollama (local) | openai | azure_openai ---
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/
# AZURE_OPENAI_API_KEY=

# --- Threat intel (all have free tiers) ---
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=
# OTX_API_KEY=

REDIS_URL=redis://localhost:6379/0

# --- Secrets: generate with `openssl rand -hex 32` ---
JWT_SECRET=CHANGE_ME
AUDIT_HMAC_KEY=CHANGE_ME

AUTONOMY_LEVEL=1
REQUIRE_APPROVAL_ABOVE_RISK=40
